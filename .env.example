# Copy to .env.local and fill in. Never commit real values.

# Claude: generates the app code and powers builder chat
CLAUDE_API_KEY=
# Optional: override the default model
CLAUDE_MODEL=

# ElevenLabs: speech-to-text for voice prompts (server-side only)
ELEVENLABS_API_KEY=

# Daytona: sandboxes that run the live preview
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=

# Supabase: sign-in / sign-up (public anon key, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# One-click deploy: new GitHub repo + Vercel project per generated app
GITHUB_TOKEN=
GITHUB_USERNAME=
VERCEL_TOKEN=

# Optional: enables POST /api/cleanup (deletes all Daytona sandboxes)
CLEANUP_TOKEN=
